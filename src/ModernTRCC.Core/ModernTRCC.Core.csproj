<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ModernTRCC.Core</RootNamespace>
    <AssemblyName>ModernTRCC.Core</AssemblyName>
    <Version>1.0.0</Version>
    <Description>Modern TRCC Core Library - LCD Screen Control</Description>
