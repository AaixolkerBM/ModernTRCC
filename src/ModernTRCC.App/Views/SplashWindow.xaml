<Window x:Class="ModernTRCC.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modern TRCC"
        Width="440" Height="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border CornerRadius="20" Background="#0A0A0B" BorderBrush="#27272A" BorderThickness="1">
        <Grid Margin="36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题（居中） -->
            <TextBlock Grid.Row="0" Text="Modern TRCC"
                       FontFamily="Sora, Segoe UI" FontSize="26" FontWeight="600" Foreground="#F5F5F5"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- 进度条：金色滑块只在灰色轨道内部来回滑动 -->
            <Grid Grid.Row="1" x:Name="ProgressTrack" Height="3" Margin="0,0,0,16" ClipToBounds="True">
                <Border Height="3" CornerRadius="1.5" Background="#27272A"/>
                <Border x:Name="ProgressFill" Height="3" Width="120" CornerRadius="1.5" Background="#C8A45E"
                        HorizontalAlignment="Left">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ProgressTranslate" X="0"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="2" Text="正在启动..." FontSize="11" Foreground="#52525B" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
