<Window x:Class="ModernTRCC.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modern TRCC"
        Width="440" Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border CornerRadius="20" Background="#0A0A0B" BorderBrush="#27272A" BorderThickness="1">
        <Grid Margin="36,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="66" Height="66" HorizontalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12 2C12 2 5 10 5 15C5 18.866 8.13401 22 12 22C15.866 22 19 18.866 19 15C19 10 12 2 12 2Z" Stroke="#C8A45E" StrokeThickness="2"/>
                        <Path Data="M9 15C9 16.657 10.343 18 12 18" Stroke="#C8A45E" StrokeThickness="2" StrokeStartLineCap="Round"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Modern TRCC" FontFamily="Sora, Segoe UI" FontSize="24" FontWeight="600" Foreground="#F5F5F5" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="水冷屏幕控制台" x:Name="SplashSub" FontSize="12" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- 进度条 -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Border Height="3" CornerRadius="1.5" Background="#27272A"/>
                <Border x:Name="ProgressFill" Height="3" Width="140" CornerRadius="1.5" Background="#C8A45E"
                        HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ProgressTranslate" X="-140"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="2" Text="正在启动..." FontSize="11" Foreground="#52525B" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
